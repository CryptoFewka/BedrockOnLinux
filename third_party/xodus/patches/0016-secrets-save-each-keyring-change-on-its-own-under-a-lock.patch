From 8a4b213b08d747b297a8fd189005713af7100a6e Mon Sep 17 00:00:00 2001
From: Chris Fuka <chris.fuka@gmail.com>
Date: Mon, 16 Nov 2026 09:23:28 -0600
Subject: [PATCH] secrets: save each keyring change on its own, under a lock

With key-chain-file nothing called save(): the sample store wrote its
whole map only when destroy_secrets() dropped it at the end of main.
The default store is held globally, so a panic never dropped it, and a
panic or a kill lost every credential the run had changed (a re-signed
device, a renewed session, a fresh sign-in). And `run` holds the store
for the whole game session, so when the game exited it wrote the map it
loaded at launch over any sign-in or sign-out made by another xodus-cli
in the meantime (xodus-gaming/xodus#246).

The file store is now built without a backing file, so dropping it
writes nothing. KeychainBackend::set and ::remove, the only writers,
call secrets::persist, which takes an flock on a sibling lock file,
re-reads the keyring, puts in or takes out just that entry, and renames
a 0600 staged copy into place. Other processes' entries survive, and
every change is on disk before the call returns. persist is a no-op for
the Secret Service and Keychain stores, which save on their own.
---
 crates/xodus/src/secrets.rs                 | 249 +++++++++++++++++++-
 crates/xodus/src/tokens/backend/keychain.rs |   8 +-
 2 files changed, 249 insertions(+), 8 deletions(-)

diff --git a/crates/xodus/src/secrets.rs b/crates/xodus/src/secrets.rs
index 5efb164..19ffb31 100644
--- a/crates/xodus/src/secrets.rs
+++ b/crates/xodus/src/secrets.rs
@@ -3,12 +3,7 @@ pub static SERVICE_NAME: &str = "Xodus Service";
 pub fn init_secrets() -> Result<(), keyring_core::Error> {
     #[cfg(feature = "key-chain-file")]
     {
-        let path = secrets_backing_file();
-        prepare_backing_file(&path)?;
-        let store = keyring_core::sample::Store::new_with_backing(
-            path.to_str().expect("Invalid secrets backing path"),
-        )?;
-        keyring_core::set_default_store(store);
+        keyring_core::set_default_store(file_keyring::open(&secrets_backing_file())?);
     }
 
     #[cfg(not(feature = "key-chain-file"))]
@@ -39,6 +34,17 @@ pub fn get_entry(user: &str) -> Result<keyring_core::Entry, keyring_core::Error>
     keyring_core::Entry::new(SERVICE_NAME, user)
 }
 
+/// Writes `user`'s entry to disk now. A no-op for stores that save on their own.
+pub fn persist(user: &str) -> Result<(), keyring_core::Error> {
+    #[cfg(feature = "key-chain-file")]
+    return file_keyring::persist(user);
+    #[cfg(not(feature = "key-chain-file"))]
+    {
+        let _ = user;
+        Ok(())
+    }
+}
+
 pub fn destroy_secrets() {
     keyring_core::unset_default_store();
 }
@@ -78,6 +84,237 @@ fn prepare_backing_file(path: &std::path::Path) -> Result<(), keyring_core::Erro
     }
 }
 
+// The sample store only saves when it is dropped, which never happens after a
+// panic, and then writes its whole map over whatever other xodus processes
+// saved meanwhile. So the store here has no backing file, and each change is
+// written on its own: under a lock, merged into the file as it is now, and
+// renamed into place.
+#[cfg(feature = "key-chain-file")]
+mod file_keyring {
+    use keyring_core::Error;
+    use keyring_core::sample::Store;
+    use keyring_core::sample::credential::CredId;
+    use keyring_core::sample::store::{CredMap, CredValue};
+    use std::fs::{File, OpenOptions};
+    use std::path::{Path, PathBuf};
+    use std::sync::{Arc, OnceLock};
+
+    static OPEN: OnceLock<(Arc<Store>, PathBuf)> = OnceLock::new();
+
+    fn failure(e: std::io::Error) -> Error {
+        Error::PlatformFailure(Box::new(e))
+    }
+
+    fn path_str(path: &Path) -> Result<&str, Error> {
+        path.to_str()
+            .ok_or_else(|| Error::Invalid("path".into(), "not UTF-8".into()))
+    }
+
+    fn private_options() -> OpenOptions {
+        let mut options = OpenOptions::new();
+        #[cfg(unix)]
+        std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+        options
+    }
+
+    // Held by every xodus process across each read-modify-write of the file.
+    fn lock(path: &Path) -> Result<File, Error> {
+        let file = private_options()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path.with_extension("ron.lock"))
+            .map_err(failure)?;
+        file.lock().map_err(failure)?;
+        Ok(file)
+    }
+
+    pub fn open(path: &Path) -> Result<Arc<Store>, Error> {
+        let store = load(path)?;
+        let _ = OPEN.set((store.clone(), path.to_path_buf()));
+        Ok(store)
+    }
+
+    pub fn persist(user: &str) -> Result<(), Error> {
+        match OPEN.get() {
+            Some((store, path)) => save_entry(store, path, user),
+            None => Ok(()),
+        }
+    }
+
+    fn load(path: &Path) -> Result<Arc<Store>, Error> {
+        let _lock = lock(path)?;
+        super::prepare_backing_file(path)?;
+        Ok(Store::new_internal(
+            Store::load_credentials(path_str(path)?)?,
+            None,
+        ))
+    }
+
+    // Puts `user`'s entry from `store` into the file, or takes it out if the
+    // store has none, and keeps every other entry as the file has it now.
+    fn save_entry(store: &Store, path: &Path, user: &str) -> Result<(), Error> {
+        let _lock = lock(path)?;
+        let creds = Store::load_credentials(path_str(path)?)?;
+        let id = CredId {
+            service: super::SERVICE_NAME.to_string(),
+            user: user.to_string(),
+        };
+        creds.remove(&id);
+        if let Some(entry) = store.creds.get(&id) {
+            let copy = entry
+                .iter()
+                .map(|value| {
+                    (
+                        value.key().clone(),
+                        CredValue {
+                            secret: value.secret.clone(),
+                            comment: value.comment.clone(),
+                            creation_date: value.creation_date.clone(),
+                        },
+                    )
+                })
+                .collect();
+            creds.insert(id, copy);
+        }
+        write_atomically(path, creds)
+    }
+
+    fn write_atomically(path: &Path, creds: CredMap) -> Result<(), Error> {
+        let staged = path.with_extension("ron.tmp");
+        let _ = std::fs::remove_file(&staged);
+        private_options()
+            .write(true)
+            .create_new(true)
+            .open(&staged)
+            .map_err(failure)?;
+        // A store backed by the staged file writes it in the sample store's own
+        // format. Dropping it writes it once more, still before the rename.
+        Store::new_internal(creds, Some(path_str(&staged)?.to_string())).save()?;
+        File::open(&staged)
+            .and_then(|file| file.sync_all())
+            .map_err(failure)?;
+        std::fs::rename(&staged, path).map_err(failure)?;
+        if let Some(dir) = path.parent()
+            && let Ok(dir) = File::open(dir)
+        {
+            let _ = dir.sync_all();
+        }
+        Ok(())
+    }
+
+    #[cfg(all(test, unix))]
+    mod tests {
+        use super::*;
+        use std::os::unix::fs::PermissionsExt;
+
+        fn scratch(name: &str) -> PathBuf {
+            let dir = std::env::temp_dir()
+                .join(format!("xodus-file-keyring-{}-{name}", std::process::id()));
+            let _ = std::fs::remove_dir_all(&dir);
+            std::fs::create_dir_all(&dir).unwrap();
+            dir.join(".xodus-keyring.ron")
+        }
+
+        fn id(user: &str) -> CredId {
+            CredId {
+                service: super::super::SERVICE_NAME.to_string(),
+                user: user.to_string(),
+            }
+        }
+
+        fn put(store: &Store, user: &str, secret: &[u8]) {
+            store.creds.insert(
+                id(user),
+                [("only".to_string(), CredValue::new(secret))]
+                    .into_iter()
+                    .collect(),
+            );
+        }
+
+        fn on_disk(path: &Path) -> Vec<(String, Vec<u8>)> {
+            let creds = Store::load_credentials(path.to_str().unwrap()).unwrap();
+            let mut found: Vec<_> = creds
+                .iter()
+                .flat_map(|e| {
+                    let user = e.key().user.clone();
+                    e.value()
+                        .iter()
+                        .map(|v| (user.clone(), v.secret.clone()))
+                        .collect::<Vec<_>>()
+                })
+                .collect();
+            found.sort();
+            found
+        }
+
+        #[test]
+        fn a_saved_entry_lands_in_a_private_file() {
+            let path = scratch("saved");
+            let store = load(&path).unwrap();
+            put(&store, "user-tokens", b"one");
+            save_entry(&store, &path, "user-tokens").unwrap();
+            assert_eq!(
+                on_disk(&path),
+                vec![("user-tokens".into(), b"one".to_vec())]
+            );
+            let mode = std::fs::metadata(&path).unwrap().permissions().mode() & 0o777;
+            assert_eq!(mode, 0o600);
+            assert!(!path.with_extension("ron.tmp").exists());
+        }
+
+        #[test]
+        fn another_process_entries_survive_a_save() {
+            let path = scratch("merge");
+            let first = load(&path).unwrap();
+            let second = load(&path).unwrap();
+            put(&first, "device-tokens", b"device");
+            save_entry(&first, &path, "device-tokens").unwrap();
+            put(&second, "user-tokens", b"user");
+            save_entry(&second, &path, "user-tokens").unwrap();
+            assert_eq!(
+                on_disk(&path),
+                vec![
+                    ("device-tokens".into(), b"device".to_vec()),
+                    ("user-tokens".into(), b"user".to_vec()),
+                ]
+            );
+        }
+
+        #[test]
+        fn a_removed_entry_leaves_the_others() {
+            let path = scratch("remove");
+            let first = load(&path).unwrap();
+            let second = load(&path).unwrap();
+            put(&first, "user-DA", b"da");
+            save_entry(&first, &path, "user-DA").unwrap();
+            put(&second, "dev_license", b"license");
+            save_entry(&second, &path, "dev_license").unwrap();
+            first.creds.remove(&id("user-DA"));
+            save_entry(&first, &path, "user-DA").unwrap();
+            assert_eq!(
+                on_disk(&path),
+                vec![("dev_license".into(), b"license".to_vec())]
+            );
+        }
+
+        #[test]
+        fn dropping_a_stale_store_writes_nothing() {
+            let path = scratch("drop");
+            let stale = load(&path).unwrap();
+            let fresh = load(&path).unwrap();
+            put(&fresh, "user-tokens", b"new");
+            save_entry(&fresh, &path, "user-tokens").unwrap();
+            drop(stale);
+            assert_eq!(
+                on_disk(&path),
+                vec![("user-tokens".into(), b"new".to_vec())]
+            );
+        }
+    }
+}
+
 #[cfg(all(test, feature = "key-chain-file", unix))]
 mod tests {
     use super::*;
diff --git a/crates/xodus/src/tokens/backend/keychain.rs b/crates/xodus/src/tokens/backend/keychain.rs
index 6aa6cde..0659fc7 100644
--- a/crates/xodus/src/tokens/backend/keychain.rs
+++ b/crates/xodus/src/tokens/backend/keychain.rs
@@ -13,10 +13,14 @@ impl TokenBackend for KeychainBackend {
     }
 
     fn set(&self, key: &str, value: &[u8]) -> Result<(), TokenStoreError> {
-        Ok(crate::secrets::get_entry(key)?.set_secret(value)?)
+        crate::secrets::get_entry(key)?.set_secret(value)?;
+        Ok(crate::secrets::persist(key)?)
     }
 
     fn remove(&self, key: &str) -> Result<(), TokenStoreError> {
-        Ok(crate::secrets::get_entry(key)?.delete_credential()?)
+        let removed = crate::secrets::get_entry(key)?.delete_credential();
+        // Persist even when this process had no entry: the file may have one.
+        crate::secrets::persist(key)?;
+        Ok(removed?)
     }
 }
-- 
