From 41512b88c320d1074ee937b83615e9b977c0a113 Mon Sep 17 00:00:00 2001
From: Chris Fuka <chris.fuka@gmail.com>
Date: Mon, 16 Nov 2026 09:21:40 -0600
Subject: [PATCH] secrets: keep the file keyring private

With key-chain-file the keyring is keyring-core's sample store, which
saves with std::fs::write. That creates the file 0644 under the usual
umask, and the file holds the device credentials and the account's DA
token and Passport session in plaintext (xodus-gaming/xodus#246).

Create the file 0600 holding an empty RON map before the store first
loads it (an empty file does not parse), or tighten an existing one to
0600. fs::write keeps the mode of a file that exists, so every later save
stays private. A process umask would do the same but would also reach the
game that `xodus-cli run` starts.
---
 crates/xodus/src/secrets.rs | 67 +++++++++++++++++++++++++++++++++++--
 1 file changed, 64 insertions(+), 3 deletions(-)

diff --git a/crates/xodus/src/secrets.rs b/crates/xodus/src/secrets.rs
index dba6b2f..5efb164 100644
--- a/crates/xodus/src/secrets.rs
+++ b/crates/xodus/src/secrets.rs
@@ -3,10 +3,10 @@ pub static SERVICE_NAME: &str = "Xodus Service";
 pub fn init_secrets() -> Result<(), keyring_core::Error> {
     #[cfg(feature = "key-chain-file")]
     {
+        let path = secrets_backing_file();
+        prepare_backing_file(&path)?;
         let store = keyring_core::sample::Store::new_with_backing(
-            secrets_backing_file()
-                .to_str()
-                .expect("Invalid secrets backing path"),
+            path.to_str().expect("Invalid secrets backing path"),
         )?;
         keyring_core::set_default_store(store);
     }
@@ -51,3 +51,64 @@ fn secrets_backing_file() -> std::path::PathBuf {
         .unwrap_or_else(std::env::temp_dir)
         .join(".xodus-keyring.ron")
 }
+
+// The sample store writes with fs::write, which creates the file 0644 and
+// keeps an existing file's mode, so make sure the file exists and is 0600
+// before the store first writes it.
+#[cfg(feature = "key-chain-file")]
+fn prepare_backing_file(path: &std::path::Path) -> Result<(), keyring_core::Error> {
+    let failure = |e: std::io::Error| keyring_core::Error::PlatformFailure(Box::new(e));
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    match options.open(path) {
+        // An empty file is not valid RON, so start from an empty map.
+        Ok(mut file) => std::io::Write::write_all(&mut file, b"{}").map_err(failure),
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))
+                    .map_err(failure)?;
+            }
+            Ok(())
+        }
+        Err(e) => Err(failure(e)),
+    }
+}
+
+#[cfg(all(test, feature = "key-chain-file", unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    fn scratch(name: &str) -> std::path::PathBuf {
+        let dir = std::env::temp_dir().join(format!("xodus-secrets-{}-{name}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        dir.join(".xodus-keyring.ron")
+    }
+
+    fn mode(path: &std::path::Path) -> u32 {
+        std::fs::metadata(path).unwrap().permissions().mode() & 0o777
+    }
+
+    #[test]
+    fn a_new_keyring_is_private_and_loadable() {
+        let path = scratch("new");
+        prepare_backing_file(&path).unwrap();
+        assert_eq!(mode(&path), 0o600);
+        keyring_core::sample::Store::new_with_backing(path.to_str().unwrap()).unwrap();
+    }
+
+    #[test]
+    fn an_existing_keyring_is_made_private_and_kept() {
+        let path = scratch("existing");
+        std::fs::write(&path, "{}").unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o644)).unwrap();
+        prepare_backing_file(&path).unwrap();
+        assert_eq!(mode(&path), 0o600);
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "{}");
+    }
+}
